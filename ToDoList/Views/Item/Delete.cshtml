@model ToDoList.Models.Item
@{
	ViewData["Title"] = "Usuń pozycję";
}

<div class=form-container>
	<form asp-action="Delete" method="post">
		<h1>Czy na pewno chcesz usunąć to zadanie?</h1>
		<div class="form-group">
			<label for="Name">Nazwa zadania:</label>
			<input type="text" class="form-control" asp-for="Name" disabled />
		</div>
		<div class="form-group">
			<label for="Description">Opis zadania:</label>
			<textarea type="text" class="form-control" asp-for="Description" rows="3" disabled> </textarea>
		</div>
		<div class="form-group">
			<label for="DueAt">Data ukończenia:</label>
			<input type="datetime-local" class="form-control" step="60" asp-for="DueAt" disabled />
		</div>
		<div class="form-group form-switch">
			<label for="Finished">Ukończone:  </label>
			<input type="checkbox" role="switch" class="form-check-input" asp-for="Finished" disabled />
		</div>
		<div class="form-buttons">
			<a asp-action="Index" asp-route-date="@Model.DueAt.ToString("yyyy-MM-dd")" class="btn btn-secondary">Powrót</a>
			<button type="submit" class="btn btn-danger">Usuń zadanie</button>
		</div>

	</form>
</div>
