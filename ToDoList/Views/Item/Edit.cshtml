@model ToDoList.Models.Item
@{
}


<h1>Edytuj zadanie</h1>
<form asp-action="Edit" method="post">
	<div class="form-group">
		<label for="Name">Nazwa zadania</label>
		<input type="text" class="form-control" asp-for="Name" />
	</div>
	<div class="form-group">
		<label for="Description">Nazwa zadania</label>
		<input type="text" class="form-control" asp-for="Description" />
	</div>
	<div class="form-group">
		<label for="Finished">Ukończone?</label>
		<input type="checkbox" class="form-check-input" asp-for="Finished" />
	</div>
	<button type="submit" class="btn btn-primary">Dodaj zadanie</button>
</form>