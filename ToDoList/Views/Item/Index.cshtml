@model List<ToDoList.Models.Item>
@{
}
<table>
    <thead>
        <tr>
            <th>Nazwa</th>
            <th>Opis</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    @if (item.Finished)
                    {
                        <span>Ukończone</span>
                    }
                    else
                    {
                        <span>W trakcie</span>
                    }
                </td>
                <td>
                    @* <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a> *@
                </td>
            </tr>
        }
    </tbody>
</table>


