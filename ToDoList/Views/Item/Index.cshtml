@model List<ToDoList.Models.Item>
@{
}
@if (Model.Count != 0)
{
    <table>
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>Opis</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    @if (item.Finished)
                    {
                        <span>Ukończone</span>
                    }
                    else
                    {
                        <span>W trakcie</span>
                    }
                    
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3>Nie masz jeszcze żadnych zadań. Dodaj nowe zadanie</h3>
}

<a asp-action="Create" class="btn btn-success">Dodaj pozycję</a>


