@model List<ToDoList.Models.Item>
@{
}
@foreach (var item in Model)
{
    <p>Nazwa pozycji: @item.Name</p>
    <p>Opis pozycji: @item.Description</p>
    <p>
        Status:
        @if (item.Finished)
        {
            <span>Ukończone</span>
        }
        else
        {
            <span>W trakcie</span>
        }
    </p>
}

