@model ToDoList.Models.Item
@{
	ViewData["Title"] = "Utwórz pozycję";
}


<div class=form-container>
	<form asp-action="Create" method="post">
		<h1>Dodaj nowe zadanie</h1>
		<div class="form-group">
			<label for="Name">Nazwa zadania:</label>
			<input type="text" class="form-control" asp-for="Name" placeholder="Podaj nazwę zadania" />
		</div>
		<div class="form-group">
			<label for="Description">Opis zadania:</label>
			<textarea type="text" class="form-control" asp-for="Description" placeholder="Podaj opis zadania (opcjonalny)" rows="3"></textarea>
		</div>
		<div class="form-group">
			<label for="DueAt">Data ukończenia:</label>
			<input type="datetime-local" class="form-control" step="60" asp-for="DueAt" />
		</div>
		<div class="form-group">
			<label for="Finished">Ukończone:</label>
			<input type="checkbox" class="form-check-input" asp-for="Finished" />
		</div>
		<div class="form-buttons">
			<a asp-action="Index" asp-route-date="@Model.DueAt.ToString("yyyy-MM-dd")" class="btn btn-secondary">Powrót</a>
			<button type="submit" class="btn btn-primary">Dodaj zadanie</button>
		</div>

	</form>
</div>

